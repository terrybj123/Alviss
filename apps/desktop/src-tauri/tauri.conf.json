{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alviss",
  "version": "0.1.0",
  "identifier": "com.alviss.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Alviss",
        "width": 1280,
        "height": 832,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: https: data:; connect-src 'self' https: ipc:; style-src 'self' 'unsafe-inline';"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "sql": {
      "preload": [
        "sqlite:plainva.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCRjlEMkMxMjIxNUMzRjIKUldUeXd4VWl3ZEw1QzEvT3FZSnU0VkNrNDcvRS9jZU1zTzVCK3VUQ3Y0dDlnazEzQVpSQ2NSVzMK",
      "endpoints": [
        "https://github.com/terrybj123/Alviss/releases/download/updater/latest.json",
        "https://github.com/terrybj123/Alviss/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
